{
  "extends": [
    "html-validate:recommended"
  ],
  "rules": {
    "no-trailing-whitespace": "off",
    "long-title": "off",
    "wcag/h30": "off",
    "no-inline-style": "error",
    "require-sri": "off",
    "void-style": "off",
    "no-redundant-role": "off",
    "doctype-style": "off",
    "prefer-native-element": "off"
  },
  "elements": [
    "html5"
  ]
}
